# ==============================================================================
# CodeSentinel - Docker Compose Environment Template
# ==============================================================================
# Copy this file to .env for local Docker testing:
#   cp .env.example .env
# Never commit .env to GitHub.
# ==============================================================================

# MySQL Database Settings
DB_NAME=codesentinel_db
DB_USER=codesentinel_user
DB_PASSWORD=replace_with_strong_db_user_password
DB_ROOT_PASSWORD=replace_with_strong_db_root_password

# JWT Authentication
JWT_SECRET=replace_with_high_entropy_jwt_secret_min32chars
JWT_EXPIRES_IN=24h

# Comma-separated allowed CORS origins (include http://<EC2_PUBLIC_IP> on EC2)
ALLOWED_ORIGINS=http://localhost,http://localhost:80
